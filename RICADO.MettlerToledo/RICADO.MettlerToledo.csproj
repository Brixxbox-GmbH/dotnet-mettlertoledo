<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0;netstandard2.0</TargetFrameworks>
    <PackageId>brixxbox.MettlerToledo</PackageId>
    <Authors>RICADO; Brixxbox GmbH</Authors>
    <Company>RICADO Limited</Company>
    <Description>A .NET 8+ and .NET Standard 2.0 Library for Communicating with Mettler Toledo Indicators</Description>
    <Copyright>Copyright © RICADO Limited 2009 - 2026</Copyright>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageIcon>packageIcon.png</PackageIcon>
    <RepositoryUrl>https://github.com/Brixxbox-GmbH/dotnet-mettlertoledo</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <PackageTags>mettler,toledo,loadcell,mt-sics,weighing,act350,sics-protocol</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="packageIcon.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RICADO.Sockets" Version="2.0.0" />
  </ItemGroup>

</Project>
